# Copy to .env and adjust. Never commit .env.

# ─────────────────────────────────────────────────────────── app
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8010

# ─────────────────────────────────────────────────────────── llm
# gpt-4o-mini is the ONLY paid component in the stack.
# Set LLM_PROVIDER=ollama for a fully zero-cost run (see ARCHITECTURE.md 4.1).
LLM_PROVIDER=openai              # openai | ollama
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-replace-me
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# ─────────────────────────────────────────────── embeddings (free, local)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_MAX_LENGTH=512         # chunks are ~400 tokens; 512 is ~4x faster than 8192
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DEVICE=cpu             # cpu | cuda
EMBEDDING_USE_FP16=false         # set true only on cuda
HF_HOME=./data/models            # keeps model weights inside the repo data dir

# ─────────────────────────────────────────────── reranking (free, local)
# Measured on 6 physical cores, 60 candidates:
#   bge-reranker-v2-m3 = 14.9s  (needs a GPU, or ONNX INT8)
#   bge-reranker-base  =  3.9s  <- the CPU default
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_TOP_N=8
RERANKER_CANDIDATES=12                    # measured: 24 cand = 5.7s, 12 = ~2.8s
# tau. Low on purpose - cross-encoder scores are not comparable across query
# types, so a high threshold falsely abstains. Calibrate on the golden set.
RERANKER_SCORE_THRESHOLD=0.01

# ─────────────────────────────────────────────────────────── qdrant
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true
QDRANT_COLLECTION=policy_chunks_v1
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128
QDRANT_SEARCH_EF=128
QDRANT_QUANTIZATION=scalar       # none | scalar  (scalar cuts RAM ~4x)

# ─────────────────────────────────────────────────────────── storage
DATABASE_URL=postgresql+psycopg://insurance:insurance@localhost:5432/insurance_rag
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE=local               # local | s3
OBJECT_STORE_PATH=./data/raw

# ─────────────────────────────────────────────────────────── ingestion
# Docling parses every PDF by default - it is the only parser that reconstructs
# benefit tables, and a flattened grid yields wrong sub-limits. Enable the fast
# parser only for a corpus you know contains no tables.
INGEST_PREFER_FAST_PARSER=false
INGEST_OCR_ENABLED=false

# ─────────────────────────────────────────────────── chunking (tune via eval)
CHUNK_CHILD_TOKENS=400
CHUNK_CHILD_OVERLAP=80
CHUNK_PARENT_MAX_TOKENS=2000
CHUNK_STRATEGY=structure_aware   # fixed | recursive | structure_aware
CONTEXTUAL_PREFIX_ENABLED=false  # LLM contextual prefix; costs tokens at ingest

# ─────────────────────────────────────────────────────────── retrieval
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_SPARSE_TOP_K=50
RETRIEVAL_BM25_ENABLED=false     # third prefetch branch for exact identifiers
RRF_K=60
CONTEXT_TOKEN_BUDGET=6000
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_VARIANTS=1
HYDE_ENABLED=false

# ─────────────────────────────────────────────────────────── cache
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.97
SEMANTIC_CACHE_TTL_SECONDS=86400

# ─────────────────────────────────────────────────────────── security
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
PII_MASKING_ENABLED=true
INJECTION_GUARD_ENABLED=true
RATE_LIMIT_PER_MINUTE=30

# ─────────────────────────────────────────────────────────── observability
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me

# ─────────────────────────────────────────────────────────── postgres (compose)
POSTGRES_USER=insurance
POSTGRES_PASSWORD=insurance
POSTGRES_DB=insurance_rag

# ────────────────────────────────────────────── published host ports (compose)
# Change these if a port is already taken on your machine. Container-internal
# ports never change, so only the left-hand side of the mapping moves.
# Remember to keep QDRANT_URL / REDIS_URL / DATABASE_URL above in sync.
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
POSTGRES_PORT=5432
VALKEY_PORT=6379
API_PORT_HOST=8010
UI_PORT_HOST=8501
LANGFUSE_PORT=3000
